default_platform(:ios)

REPO_ROOT = File.expand_path("../..", Dir.pwd)

def required_env(name, hint)
  ENV.fetch(name) { UI.user_error!("#{name} is not set — #{hint}") }
end

platform :ios do
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: required_env("ASC_KEY_ID", "set it from GitHub Secrets"),
      issuer_id: required_env("ASC_ISSUER_ID", "set it from GitHub Secrets"),
      key_content: required_env("ASC_KEY_CONTENT", "base64 of the .p8, from GitHub Secrets"),
      is_key_content_base64: true,
    )

    setup_ci if is_ci

    match(readonly: is_ci, api_key: api_key)

    build_args = [
      "build", "ipa",
      "--release",
      "--build-number=#{required_env('BUILD_NUMBER', 'CI sets it from github.run_number')}",
      "--export-options-plist=ios/ExportOptions.plist",
    ]
    build_name = ENV["BUILD_NAME"].to_s
    build_args << "--build-name=#{build_name}" unless build_name.empty?

    Dir.chdir(REPO_ROOT) { sh("flutter", *build_args) }

    ipa = Dir[File.join(REPO_ROOT, "build", "ios", "ipa", "*.ipa")].first
    UI.user_error!("No .ipa found in build/ios/ipa") if ipa.nil?

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      groups: ["Internal"],
    )
  end
end
